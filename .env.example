# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the deployed site (used for sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable key" (sb_publishable_…) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_…) or the legacy "service_role" key. Server only!
SUPABASE_SECRET_KEY=

# ── Admin panel ───────────────────────────────────────────────
# Password to sign in at /admin
ADMIN_PASSWORD=change-me-to-something-long
# Random string (32+ chars) used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Gemini chatbot (https://aistudio.google.com/apikey) ───────
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-flash-latest

# ── Google Maps (optional) ─────────────────────────────────
# Not needed: the map uses the embed link set in Admin → Site content → Contact & map.
# Only used as a fallback (Maps Embed API) when no embed link is set.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
